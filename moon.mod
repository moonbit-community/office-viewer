name = "moonbit-community/office-viewer"

version = "0.2.4"

import {
  "moonbit-community/rabbita@0.16.3",
  "moonbitlang/docx2html@0.7.1",
  "moonbitlang/mbtexcel@0.3.1",
  "moonbitlang/pagelayout@0.8.1",
  "moonbitlang/x@0.5.6",
  "moonbit-community/flate@0.10.0",
}

license = "Apache-2.0"

