import {
  "moonbit-community/rabbita",
  "moonbit-community/rabbita/cmd",
  "moonbit-community/rabbita/html",
  "moonbit-community/rabbita/js",
  "moonbitlang/core/json",
  "moonbitlang/core/string",
  "moonbitlang/x/crypto",
  "moonbitlang/docx2html",
  "moonbitlang/docx2html/document",
  "moonbitlang/docx2html/docx" @reader,
  "moonbitlang/mbtexcel",
  "moonbitlang/mbtexcel/inspect",
  "moonbitlang/mbtexcel/xlsx",
  "moonbitlang/mbtexcel/xlsx2html",
  "moonbitlang/pagelayout",
  "moonbitlang/pagelayout/docx",
  "moonbitlang/pagelayout/svg",
}

import {
  "moonbitlang/mbtexcel/demos",
} for "wbtest"

import {
  "moonbitlang/core/json",
} for "test"

warnings = "-alert_experimental-alert_xss_vulnerable"

supported_targets = "js"

pkgtype(kind: "library")
